{
  "version": 1,
  "units": "mm",
  "parameters": {
    "length": 80,
    "width": 50,
    "thickness": 6,
    "holeDiameter": 6,
    "xCount": 2,
    "yCount": 2,
    "xPitch": 50,
    "yPitch": 30
  },
  "features": [
    {
      "id": "plate",
      "op": "box",
      "origin": [0, 0, 0],
      "size": [{"param": "length"}, {"param": "width"}, {"param": "thickness"}]
    },
    {
      "id": "mounts",
      "op": "face_hole_grid",
      "input": "plate",
      "face": "pos_z",
      "center": [{"op": "div", "a": {"param": "length"}, "b": 2}, {"op": "div", "a": {"param": "width"}, "b": 2}],
      "count": [{"param": "xCount"}, {"param": "yCount"}],
      "spacing": [{"param": "xPitch"}, {"param": "yPitch"}],
      "radius": {"op": "div", "a": {"param": "holeDiameter"}, "b": 2},
      "depth": {"param": "thickness"}
    }
  ],
  "output": "mounts"
}
