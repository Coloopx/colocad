{
  "version": 1,
  "units": "mm",
  "parameters": {
    "width": 60,
    "depth": 40,
    "height": 22,
    "wall": 2,
    "floor": 3,
    "portWidth": 12,
    "portHeight": 6,
    "portCenterZ": 12
  },
  "features": [
    {
      "id": "shell",
      "op": "shell_body",
      "profile": {"kind": "rectangle", "width": {"param": "width"}, "depth": {"param": "depth"}},
      "height": {"param": "height"},
      "wall": {"param": "wall"},
      "floor": {"param": "floor"},
      "open_face": "top"
    },
    {
      "id": "port",
      "op": "face_cutout",
      "input": "shell",
      "face": "pos_y",
      "center": [0, {"param": "portCenterZ"}],
      "profile": {"kind": "rectangle", "width": {"param": "portWidth"}, "depth": {"param": "portHeight"}},
      "depth": {"param": "wall"}
    }
  ],
  "output": "port"
}
