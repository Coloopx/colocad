{
  "name": "@coloopx/colocad",
  "version": "0.1.0-alpha.9",
  "description": "Parametric feature instructions, a local Rust B-rep kernel and an experimental SolidWorks author",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coloopx/colocad.git"
  },
  "homepage": "https://github.com/Coloopx/colocad",
  "bugs": {
    "url": "https://github.com/Coloopx/colocad/issues"
  },
  "main": "./src/index.mjs",
  "types": "./src/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./kernel": {
      "types": "./kernel/dist/index.d.ts",
      "import": "./kernel/dist/index.js"
    },
    "./schema": "./kernel/schemas/model.schema.json",
    "./session": {
      "types": "./src/session.d.mts",
      "import": "./src/session.mjs"
    },
    "./viewer": {
      "types": "./viewer/index.d.ts",
      "import": "./viewer/dist/index.js"
    }
  },
  "bin": {
    "colocad": "bin/colocad.mjs"
  },
  "files": [
    "bin/colocad.mjs",
    "src",
    "kernel/dist",
    "kernel/native",
    "kernel/schemas",
    "kernel/licenses",
    "solidworks/managed",
    "examples/manifold.json",
    "examples/sensor-rail.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "skills/colocad",
    "kernel/release.json",
    "kernel/catalog.json",
    "scripts/check-release.mjs",
    "README.zh-CN.md",
    "viewer/dist",
    "viewer/index.d.ts",
    "viewer/THREE-LICENSE",
    "examples/hiwin-kk60/model.mjs",
    "examples/hiwin-kk60/run.mjs",
    "examples/hiwin-kk60/README.md",
    "examples/hiwin-kk60/sources.json",
    "examples/integrations/compact-tools.mjs",
    "examples/integrations/guided-workflow.mjs",
    "docs/*.md",
    "benchmarks/query-io/README.md",
    "docs/integrations/*.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "ROADMAP.zh-CN.md",
    "docs/cadquery-coverage.json",
    "docs/benchmarks/alpha9/*.json",
    "docs/benchmarks/alpha9/*.svg",
    "docs/benchmarks/alpha9/scorecard.html",
    "docs/benchmarks/bounded/comparison.html",
    "docs/benchmarks/bounded/observations.json",
    "docs/benchmarks/alpha9/hand-window.gif",
    "showcase/hiwin-kk60/modeling-alpha9.gif"
  ],
  "scripts": {
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs --check",
    "test": "node --test test/*.test.mjs",
    "build:kernel": "node scripts/build-kernel.mjs",
    "prepack": "node scripts/check-release.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "test:viewer": "node test/viewer.browser.mjs",
    "test:integrations": "npm test --prefix examples/integrations",
    "test:render": "node test/render.browser.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "three": "0.187.0"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0 <2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
