# Use a minimal context containing Cargo.toml, Cargo.lock, crates/ and third_party/.
FROM rust:1.98.0-slim-bookworm@sha256:1469a27c125cb5a3aebfa4f4e4665d935b02fb72cc093b2c974b3d740e43f157 AS sources
ARG TARGETARCH
WORKDIR /src
COPY third_party/solidcore-source.tar.gz /tmp/solidcore.tar.gz
RUN echo "fd75dd9a3bbfe37e320a7d47f05a6a48566f8ffc93128eff92124b9259d812c0  /tmp/solidcore.tar.gz" | sha256sum -c - && mkdir -p vendor/solidcore && tar xzf /tmp/solidcore.tar.gz --strip-components=1 -C vendor/solidcore && rm /tmp/solidcore.tar.gz
RUN apt-get update && apt-get install -y --no-install-recommends patch && rm -rf /var/lib/apt/lists/*
COPY third_party/patches/face37.patch /tmp/face37.patch
COPY third_party/solidcore.lock.json third_party/solidcore.lock.json
RUN echo "1b4b3a591eeb0b95960f1b0afb511a3e32c95be1c188aad7c31fd275001cf284  /tmp/face37.patch" | sha256sum -c - && cd vendor/solidcore && patch -s -p1 < /tmp/face37.patch && echo "6a98cd34469c4649551638dcbf1c0cf24c552f95025e41dba436d50df207360b  crates/solidcore/src/topology/face/p4.rs" | sha256sum -c -
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Separate target caches and lock registry extraction: concurrent platform builds
# must not unpack or overwrite the same Cargo cache entries.
FROM sources AS catalog-builder
RUN --mount=type=cache,id=colocad-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked --mount=type=cache,id=colocad-target-${TARGETARCH},target=/src/target,sharing=locked cargo build --release --locked -p colocad-catalog && cp target/release/colocad-catalog /colocad-catalog
FROM scratch AS catalog
COPY --from=catalog-builder /colocad-catalog /colocad-catalog

FROM sources AS builder
RUN --mount=type=cache,id=colocad-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked --mount=type=cache,id=colocad-target-${TARGETARCH},target=/src/target,sharing=locked cargo build --release --locked -p agent-cad && cp target/release/agent-cad /agent-cad
FROM scratch
COPY --from=builder /agent-cad /agent-cad
COPY --from=catalog-builder /colocad-catalog /colocad-catalog
