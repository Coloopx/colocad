# [INPUT]: SHA固定SolidCore归档、顺序补丁与Colocad源码。
# [OUTPUT]: Linux agent-cad与catalog镜像。
# [POS]: 原生构建与scripts/vendor.mjs消费同一锁定补丁集合。
# [PROTOCOL]: 变更时更新此头部，然后检查 AGENTS.md
# Use a minimal context containing Cargo.toml, Cargo.lock, crates/ and third_party/.
FROM rust:1.98.0-slim-bookworm@sha256:1469a27c125cb5a3aebfa4f4e4665d935b02fb72cc093b2c974b3d740e43f157 AS sources
ARG TARGETARCH
WORKDIR /src
COPY third_party/solidcore-source.tar.gz /tmp/solidcore.tar.gz
RUN echo "fd75dd9a3bbfe37e320a7d47f05a6a48566f8ffc93128eff92124b9259d812c0  /tmp/solidcore.tar.gz" | sha256sum -c - && mkdir -p vendor/solidcore && tar xzf /tmp/solidcore.tar.gz --strip-components=1 -C vendor/solidcore && rm /tmp/solidcore.tar.gz
RUN apt-get update && apt-get install -y --no-install-recommends patch && rm -rf /var/lib/apt/lists/*
COPY third_party/patches/face37.patch /tmp/face37.patch
COPY third_party/solidcore.lock.json third_party/solidcore.lock.json
RUN echo "1b4b3a591eeb0b95960f1b0afb511a3e32c95be1c188aad7c31fd275001cf284  /tmp/face37.patch" | sha256sum -c - && cd vendor/solidcore && echo "49f66a213b3380da6456f9416e26bce357547a0edab49fbc19ee3907fb44173e  crates/solidcore/src/topology/face/p4.rs" | sha256sum -c - && patch -s -p1 --fuzz=0 < /tmp/face37.patch && echo "6a98cd34469c4649551638dcbf1c0cf24c552f95025e41dba436d50df207360b  crates/solidcore/src/topology/face/p4.rs" | sha256sum -c -
COPY third_party/patches/validation-properties.patch /tmp/validation-properties.patch
RUN echo "e04a63173c313ebb56bcb547112e8b650ed35faa3790423fe69c4eb01512131c  /tmp/validation-properties.patch" | sha256sum -c - && cd vendor/solidcore && echo "0f46ccb8e23a0548ce3334fb0c93d7b9cc55306fc3a5441c8c1d92eb3bc3d26d  crates/solidcore/src/kernel.rs" | sha256sum -c - && echo "2efbdd8a7a49fe7e418bbfa011ad38522ef257b1c68986e0bc4b314650f6837e  crates/solidcore/src/nurbs/b_spline_curve/p3.rs" | sha256sum -c - && patch -s -p1 --fuzz=0 < /tmp/validation-properties.patch && echo "9862a6b81c680d763e684639f0608c07945e40e59e0aa9e4013a70e3d9d1ad85  crates/solidcore/src/kernel.rs" | sha256sum -c - && echo "9cfc3b6d57393681241fae43470c7c1526d2ee29fea2c8d2f2b99d32654972ff  crates/solidcore/src/nurbs/b_spline_curve/p3.rs" | sha256sum -c -
COPY third_party/patches/planar-conic-domain.patch /tmp/planar-conic-domain.patch
RUN echo "081b1f711ab04506336c37c609ea92e868428e52663be8952e2447ffdccddb1e  /tmp/planar-conic-domain.patch" | sha256sum -c - && cd vendor/solidcore && echo "f6f01ffe341d010304b92ec71db252e083f144940866e878b3163a8363c09bbe  crates/step-import/src/script.rs" | sha256sum -c - && patch -s -p1 --fuzz=0 < /tmp/planar-conic-domain.patch && echo "4f25ff2e1cf10b34f03bf7de7b0c46c1eb85d34a2e580518cc6e7d0b8d2aab00  crates/step-import/src/script.rs" | sha256sum -c -
COPY third_party/patches/periodic-seam-trims.patch /tmp/periodic-seam-trims.patch
RUN echo "444ffc26b4cda9681e96524771c89bd3a40e71d58b5e3a896445c469a5b7aa12  /tmp/periodic-seam-trims.patch" | sha256sum -c - && cd vendor/solidcore && echo "35d46a92e877f297e8ada5f1e9f505dfd555c6362e15c842b5d8a410808a3e8f  crates/step-brep/src/lib.rs" | sha256sum -c - && patch -s -p1 --fuzz=0 < /tmp/periodic-seam-trims.patch && echo "accd25d0d4520888a2bd457ea7508d48e7a5336a31bb032adfc9cbd1a16f7ef3  crates/step-brep/src/lib.rs" | sha256sum -c -
COPY third_party/patches/step-brep-end-poles.patch /tmp/step-brep-end-poles.patch
RUN echo "2bf54095bdd419044eaa06a1153d2501150d47658cac7223c4797ed45f1644d1  /tmp/step-brep-end-poles.patch" | sha256sum -c - && cd vendor/solidcore && echo "accd25d0d4520888a2bd457ea7508d48e7a5336a31bb032adfc9cbd1a16f7ef3  crates/step-brep/src/lib.rs" | sha256sum -c - && patch -s -p1 --fuzz=0 < /tmp/step-brep-end-poles.patch && echo "f36c9a77a0cbbc7b941e029f0365ec1c13e823e4b7a553d10778ed99b13d9bc6  crates/step-brep/src/lib.rs" | sha256sum -c -
COPY third_party/patches/uv-metric-regularity.patch /tmp/uv-metric-regularity.patch
RUN echo "4131f330bcffdb530de3ec21734b0df925d6f2d3214e1569b8315f05f49213ea  /tmp/uv-metric-regularity.patch" | sha256sum -c - && cd vendor/solidcore && echo "9cfc3b6d57393681241fae43470c7c1526d2ee29fea2c8d2f2b99d32654972ff  crates/solidcore/src/nurbs/b_spline_curve/p3.rs" | sha256sum -c - && patch -s -p1 --fuzz=0 < /tmp/uv-metric-regularity.patch && echo "01b88e2c3ae5f1de33a309c3ae83c0ff99661c2c03965bac2a2144eca7910778  crates/solidcore/src/nurbs/b_spline_curve/p3.rs" | sha256sum -c -
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Separate target caches and lock registry extraction: concurrent platform builds
# must not unpack or overwrite the same Cargo cache entries.
FROM sources AS catalog-builder
RUN --mount=type=cache,id=colocad-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked --mount=type=cache,id=colocad-target-${TARGETARCH},target=/src/target,sharing=locked cargo build --release --locked -p colocad-catalog && cp target/release/colocad-catalog /colocad-catalog
FROM scratch AS catalog
COPY --from=catalog-builder /colocad-catalog /colocad-catalog

FROM sources AS builder
RUN --mount=type=cache,id=colocad-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked --mount=type=cache,id=colocad-target-${TARGETARCH},target=/src/target,sharing=locked cargo build --profile distribution --locked -p agent-cad && cp target/distribution/agent-cad /agent-cad
FROM scratch
COPY --from=builder /agent-cad /agent-cad
COPY --from=catalog-builder /colocad-catalog /colocad-catalog
