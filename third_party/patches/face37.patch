+// A positive-weight UV spline on its knot domain stays in the convex hull of
+// its Euclidean poles. For Face37 only Inside fails: a point strictly outside
+// this box cannot wind around the loop. Unknown trims use the original walk.
+fn nesting_hull(b: &Brep, l: LoopId) -> Option<[f64; 4]> {
+    use crate::curve::curve::p2::CurveKind;
+    let lu = b.loop_(l).ok()?.loopuse?;
+    let mut bounds = [
+        f64::INFINITY,
+        f64::INFINITY,
+        f64::NEG_INFINITY,
+        f64::NEG_INFINITY,
+    ];
+    for eu in eu1::loopuse_edgeuses(b, lu).ok()? {
+        let edge = b.edge(b.edgeuse(eu).ok()?.edge?).ok()?;
+        edge.curve.as_ref()?;
+        let trim = eu1::uv_trim_curve(b, eu).ok()?.0?;
+        let CurveKind::BSpline(curve) = trim.kind() else {
+            return None;
+        };
+        let domain = curve.natural_interval();
+        if !(edge.interval.min() >= domain.min() && edge.interval.max() <= domain.max()) {
+            return None;
+        }
+        let (poles, weights) = curve.control_polygon().ok()?;
+        if poles.is_empty() || !weights.iter().all(|w| w.is_finite() && *w > 0.) {
+            return None;
+        }
+        for p in poles {
+            if !(p.x.is_finite() && p.y.is_finite()) {
+                return None;
+            }
+            bounds[0] = bounds[0].min(p.x);
+            bounds[1] = bounds[1].min(p.y);
+            bounds[2] = bounds[2].max(p.x);
+            bounds[3] = bounds[3].max(p.y);
+        }
+    }
+    bounds.iter().all(|x| x.is_finite()).then_some(bounds)
+}
