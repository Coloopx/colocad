+// 投影为A*cos(t)+B*sin(t)。导数零点每隔180度；mapper有界弧至多一周。
+fn planar_conic_extrema(e: &crate::model::Edge, plane: &crate::model::Frame) -> Vec<P3> {
+    let (f, a, b) = match &e.curve {
+        Curve::Circle { frame, radius } => (frame, *radius, *radius),
+        Curve::Ellipse { frame, semi1, semi2 } => (frame, *semi1, *semi2),
+        _ => return Vec::new(),
+    };
+    let (lo, hi) = (e.t_start.min(e.t_end), e.t_start.max(e.t_end));
+    let mut points = Vec::new();
+    for axis in [plane.x, plane.y] {
+        let (x, y) = (a * dot(f.x, axis), b * dot(f.y, axis));
+        if x == 0.0 && y == 0.0 { continue; }
+        let angle = y.atan2(x).to_degrees();
+        let first = angle + 180.0 * ((lo - angle) / 180.0).ceil();
+        for i in 0..3 {
+            let t = first + 180.0 * f64::from(i);
+            if t >= lo && t <= hi { points.push(conic(f, a, b, t)); }
+        }
+    }
+    points
+}
