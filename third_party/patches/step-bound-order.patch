+// ---- 全域UV对应证书：不采样、不改网、不放宽tol ----------------------
+mod uv_proof {
+    // [INPUT]: 真实Line或BSpline/Ellipse的existing NURB与实际edge.interval。
+    // [OUTPUT]: 全域仿射/正有理控制网的outward L1界，无法证明则Err。
+    // [POS]: bound_order包含查询前的纯读证书；保留原kernel绕向/Level1。
+    // [PROTOCOL]: 变更时更新此头部，然后检查 AGENTS.md
+    use solidcore::{Vec2, Vec3, curve::{curve::{Curve, CurveKind}, line::Line},
+        geom::{extent1d::Extent1d, extent2d::Extent2d}, nurbs::{crv_basic::Curve as Nurb, math::{NOW, NOZ}},
+        surface::{plane::Plane, surface::{Surface, SurfaceKind}}};
+
+    #[derive(Clone, Copy)]
+    struct Bound { lo: f64, hi: f64 }
+    impl Bound {
+        const INVALID: Self = Self { lo: f64::NAN, hi: f64::NAN };
+        fn point(x: f64) -> Self { Self { lo: x, hi: x } }
+        fn valid(self) -> bool { self.lo.is_finite() && self.hi.is_finite() && self.lo <= self.hi }
+        fn add(self, b: Self) -> Self {
+            Self { lo: (self.lo+b.lo).next_down(), hi: (self.hi+b.hi).next_up() }
+        }
+        fn sub(self, b: Self) -> Self {
+            Self { lo: (self.lo-b.hi).next_down(), hi: (self.hi-b.lo).next_up() }
+        }
+        fn mul(self, b: Self) -> Self {
+            if !self.valid() || !b.valid() { return Self::INVALID; }
+            let products = [self.lo*b.lo, self.lo*b.hi, self.hi*b.lo, self.hi*b.hi];
+            if products.iter().any(|x| !x.is_finite()) { return Self::INVALID; }
+            Self { lo: products.into_iter().fold(f64::INFINITY,f64::min).next_down(),
+                hi: products.into_iter().fold(f64::NEG_INFINITY,f64::max).next_up() }
+        }
+        fn div(self, b: Self) -> Self {
+            if !b.valid() || b.lo <= 0.0 && b.hi >= 0.0 { return Self::INVALID; }
+            self.mul(Self { lo:(1.0/b.hi).next_down(), hi:(1.0/b.lo).next_up() })
+        }
+        fn abs_upper(self) -> f64 {
+            if self.valid() { self.lo.abs().max(self.hi.abs()) } else { f64::INFINITY }
+        }
+    }
+    type Point = [Bound; 3];
+    fn point(v: Vec3) -> Point { [v.x,v.y,v.z].map(Bound::point) }
+    fn norm(v: Point) -> f64 {
+        v.into_iter().fold(Bound::point(0.0),|s,x| s.add(Bound::point(x.abs_upper()))).hi
+    }
+    fn distance(a: Point, b: Point) -> f64 { norm(std::array::from_fn(|i| a[i].sub(b[i]))) }
+    fn unknown(reason: &str) -> String { format!("UV_PROOF_UNKNOWN: {reason}") }
+
+    struct Affine<'a> { plane: &'a Plane, origin: Point, u: Point, v: Point }
+    impl<'a> Affine<'a> {
+        fn new(plane: &'a Plane) -> Result<Self,String> {
+            let p=plane.position(); let scale=plane.uv_scale();
+            let out=Self { plane, origin:point(p.origin()),
+                u:point(p.x_axis()).map(|x| x.mul(Bound::point(scale.x))),
+                v:point(p.y_axis()).map(|x| x.mul(Bound::point(scale.y))) };
+            if out.origin.iter().chain(&out.u).chain(&out.v).any(|x| !x.valid()) {
+                return Err(unknown("non-finite plane affine data"));
+            }
+            Ok(out)
+        }
+        fn lift(&self, q: Point, weight: f64) -> Point {
+            std::array::from_fn(|i| self.origin[i].mul(Bound::point(weight))
+                .add(self.u[i].mul(q[0])).add(self.v[i].mul(q[1])))
+        }
+        fn clamp_bound(&self, hull: [Bound;2]) -> Result<f64,String> {
+            if self.plane.is_out_of_bounds_enabled() { return Ok(0.0); }
+            let d=self.plane.step_uv_domain();
+            let domains=[[d.u_min(),d.u_max()],[d.v_min(),d.v_max()]];
+            let mut total=Bound::point(0.0);
+            for (i, axis) in [self.u,self.v].into_iter().enumerate() {
+                let [lo,hi]=domains[i]; let h=hull[i];
+                if !h.valid() || !lo.is_finite() || !hi.is_finite() || lo>hi {
+                    return Err(unknown("invalid clamp domain/hull"));
+                }
+                let over=Bound::point(lo).sub(Bound::point(h.lo)).hi
+                    .max(Bound::point(h.hi).sub(Bound::point(hi)).hi).max(0.0);
+                total=total.add(Bound::point(over).mul(Bound::point(norm(axis))));
+            }
+            if !total.valid() { return Err(unknown("clamp bound overflow")); }
+            Ok(total.hi)
+        }
+    }
+    fn hull(points: impl IntoIterator<Item=Point>) -> Result<[Bound;2],String> {
+        let mut out=[Bound { lo:f64::INFINITY,hi:f64::NEG_INFINITY };2];
+        for p in points {
+            for i in 0..2 {
+                if !p[i].valid() { return Err(unknown("non-finite UV control hull")); }
+                out[i].lo=out[i].lo.min(p[i].lo); out[i].hi=out[i].hi.max(p[i].hi);
+            }
+        }
+        Ok(out)
+    }
+    fn accept(error: f64, clamp: f64, tol: f64) -> Result<(),String> {
+        let bound=Bound::point(error).add(Bound::point(clamp));
+        if !bound.valid() || bound.hi>tol {
+            return Err(format!("UV_PROOF_BOUND_EXCEEDS_TOL: bound={} tolerance={tol}",bound.hi));
+        }
+        Ok(())
+    }
+    fn line_end(line: &Line, t: f64) -> Result<Point,String> {
+        let n=line.natural_interval(); let a=line.step_interval();
+        if !line.is_bounded() || !t.is_finite() || t<n.min() || t>n.max()
+            || !n.min().is_finite() || !n.max().is_finite()
+            || !a.min().is_finite() || !a.max().is_finite()
+            || a.min()>=a.max() || solidcore::geom::tol::is_zero(n.length()) {
+            return Err(unknown("unbounded, degenerate or outside analytic line"));
+        }
+        let nlen=Bound::point(n.max()).sub(Bound::point(n.min()));
+        let numerator=Bound::point(t).sub(Bound::point(if line.inside_out() { n.max() } else { n.min() }));
+        let denominator=if line.inside_out() { Bound::point(0.0).sub(nlen) } else { nlen };
+        let step=Bound::point(a.min()).add(numerator.div(denominator)
+            .mul(Bound::point(a.max()).sub(Bound::point(a.min()))));
+        let origin=point(line.line_point()); let vector=point(line.line_vector());
+        let result: Point=std::array::from_fn(|i| origin[i].add(step.mul(vector[i]).mul(Bound::point(line.line_scale()))));
+        if result.iter().any(|x| !x.valid()) { return Err(unknown("analytic line bound overflow")); }
+        Ok(result)
+    }
+    fn lines(a: &Line, interval: &Extent1d, b: &Line, plane: &Affine<'_>, tol: f64) -> Result<(),String> {
+        let source=[line_end(a,interval.min())?,line_end(a,interval.max())?];
+        let n=b.natural_interval(); let uv=[line_end(b,n.min())?,line_end(b,n.max())?];
+        let lifted=uv.map(|q| plane.lift(q,1.0));
+        let forward=distance(source[0],lifted[0]).max(distance(source[1],lifted[1]));
+        let reverse=distance(source[0],lifted[1]).max(distance(source[1],lifted[0]));
+        accept(forward.min(reverse),plane.clamp_bound(hull(uv)?)?,tol)
+    }
+    fn nurb(curve: &Curve) -> Result<&Nurb,String> {
+        // Circle属于Ellipse；两者EvaluatePoint确实使用这份existing base，不重建理想conic。
+        let base=match curve.kind() {
+            CurveKind::BSpline(b)=>b, CurveKind::Ellipse(e)=>e.base(),
+            _=>return Err(unknown("unsupported curve representation")),
+        };
+        base.gw_nurb().ok_or_else(|| unknown("missing existing NURB"))
+    }
+    fn valid_nurb(c: &Nurb) -> Result<(),String> {
+        let p=c.degree(); let cp=c.cpts(); let knots=c.knots();
+        let expected=cp.len().checked_add(p).and_then(|n| n.checked_add(1));
+        if p==0 || p>=cp.len() || expected!=Some(knots.len())
+            || knots.iter().any(|x| !x.is_finite()) || knots.windows(2).any(|s| s[0]>s[1]) {
+            return Err(unknown("invalid complete NURB shape"));
+        }
+        let (lo,hi)=c.param_bounds();
+        if lo>=hi || knots[..=p].iter().any(|x| *x!=lo)
+            || knots[cp.len()..].iter().any(|x| *x!=hi) {
+            return Err(unknown("NURB is not end-clamped over its full domain"));
+        }
+        let non_rational=cp[0].w==NOW;
+        let mut repeat=1;
+        for j in p+1..cp.len() {
+            repeat=if knots[j]==knots[j-1] { repeat+1 } else { 1 };
+            if repeat>p || knots[j]<=lo || knots[j]>=hi {
+                return Err(unknown("unproven interior knot multiplicity"));
+            }
+        }
+        if cp.iter().any(|v| (v.w==NOW)!=non_rational || !v.x.is_finite() || !v.y.is_finite()
+            || (!non_rational && (!v.w.is_finite() || v.w<=0.0))) {
+            return Err(unknown("non-positive, mixed or non-finite homogeneous data"));
+        }
+        Ok(())
+    }
+
+    pub(super) fn control_hull_domain<'a>(
+        plane: &Plane,
+        mut domain: Extent2d,
+        curves: impl Iterator<Item = &'a Curve>,
+    ) -> Result<Extent2d, String> {
+        domain = domain.union(&plane.step_uv_domain());
+        for curve in curves.filter(|curve| !matches!(curve.kind(), CurveKind::Line(_))) {
+            let net = nurb(curve)?;
+            valid_nurb(net)?;
+            for p in net.cpts() {
+                let w = if p.w == NOW { 1.0 } else { p.w };
+                let uv = plane.project_point_to_uv_domain(Vec3::new(p.x / w, p.y / w, p.z / w));
+                if !uv.x.is_finite() || !uv.y.is_finite() || p.z == NOZ {
+                    return Err(unknown("invalid projected control hull"));
+                }
+                domain.add_point(Vec2::new(uv.x.next_down(), uv.y.next_down()));
+                domain.add_point(Vec2::new(uv.x.next_up(), uv.y.next_up()));
+            }
+        }
+        Ok(domain)
+    }
+
+    type Pole = [Bound; 4];
+
+    // Boehm insertion encloses every rounded homogeneous coordinate. A full
+    // multiplicity at both limits separates the requested span without resampling.
+    fn split_knot(knots: &mut Vec<f64>, poles: &mut Vec<Pole>, u: f64, degree: usize) {
+        let first_knot = knots.partition_point(|&knot| knot < u);
+        let mut past_knot = knots.partition_point(|&knot| knot <= u);
+        while past_knot - first_knot <= degree {
+            let span = past_knot - 1;
+            let first = span - degree;
+            let last = first_knot - 1;
+            let duplicate = poles[last];
+            for i in (first + 1..=last).rev() {
+                let lower = Bound::point(knots[i]);
+                let alpha = Bound::point(u).sub(lower).div(Bound::point(knots[i + degree]).sub(lower));
+                let beta = Bound::point(1.0).sub(alpha);
+                poles[i] = std::array::from_fn(|j| poles[i - 1][j].mul(beta).add(poles[i][j].mul(alpha)));
+            }
+            poles.insert(last + 1, duplicate);
+            knots.insert(past_knot, u);
+            past_knot += 1;
+        }
+    }
+
+    fn bounded_net(
+        a: &Nurb,
+        interval: &Extent1d,
+        b: &Nurb,
+    ) -> Result<Vec<Pole>, String> {
+        let (lo, hi) = a.param_bounds();
+        let bounds = (interval.min(), interval.max());
+        if bounds.0 < lo || bounds.1 > hi || bounds == (lo, hi) || bounds != b.param_bounds()
+            || a.degree() != b.degree()
+        {
+            return Err(unknown("bounded edge/full domain or rational basis mismatch"));
+        }
+        let mut knots = a.knots().to_vec();
+        let mut poles: Vec<Pole> = a.cpts().iter().map(|p| {
+            [p.x, p.y, p.z, if p.w == NOW { 1.0 } else { p.w }].map(Bound::point)
+        }).collect();
+        if poles.iter().any(|p| !p[2].valid() || p[2].lo == NOZ) {
+            return Err(unknown("non-3D source control"));
+        }
+        let degree = a.degree();
+        split_knot(&mut knots, &mut poles, bounds.0, degree);
+        split_knot(&mut knots, &mut poles, bounds.1, degree);
+        let start = knots.partition_point(|&knot| knot < bounds.0);
+        let end = knots.partition_point(|&knot| knot <= bounds.1);
+        if &knots[start..end] != b.knots() {
+            return Err(unknown("trimmed curve has a different rational basis"));
+        }
+        Ok(poles[start..end - degree - 1].to_vec())
+    }
+
+    fn bounded_error(source: &[Pole], b: &Nurb, plane: &Affine<'_>, tol: f64) -> Result<(), String> {
+        let mut min_weight = f64::INFINITY;
+        let mut max_weight_delta = 0.0_f64;
+        let mut max_spatial_delta = 0.0_f64;
+        let mut max_lifted_distance = 0.0_f64;
+        let mut hull_points = Vec::with_capacity(source.len());
+        for (p, q) in source.iter().zip(b.cpts()) {
+            let qw = if q.w == NOW { 1.0 } else { q.w };
+            let weight = Bound::point(qw);
+            let uv = [q.x, q.y, 0.0].map(Bound::point);
+            let lifted = plane.lift(uv, qw);
+            if !p[3].valid() || p[3].lo <= 0.0 {
+                return Err(unknown("non-positive weight on trimmed interval"));
+            }
+            min_weight = min_weight.min(p[3].lo);
+            max_weight_delta = max_weight_delta.max(p[3].sub(weight).abs_upper());
+            max_spatial_delta = max_spatial_delta.max(distance([p[0], p[1], p[2]], lifted));
+            max_lifted_distance = max_lifted_distance.max(norm(lifted.map(|v| v.div(weight))));
+            hull_points.push(uv.map(|v| v.div(weight)));
+        }
+        // A/W − B/V = ((A−B) + (B/V)(V−W))/W. Identical knots make the
+        // nonnegative basis sum to one, so each maximum bounds every parameter.
+        let error = Bound::point(max_spatial_delta)
+            .add(Bound::point(max_lifted_distance).mul(Bound::point(max_weight_delta)))
+            .div(Bound::point(min_weight)).abs_upper();
+        accept(error, plane.clamp_bound(hull(hull_points)?)?, tol)
+    }
+
+    fn nets(source: &Curve, interval: &Extent1d, uv: &Curve, plane: &Affine<'_>, tol: f64) -> Result<(),String> {
+        let a=nurb(source)?; let b=nurb(uv)?; valid_nurb(a)?; valid_nurb(b)?;
+        let (lo,hi)=a.param_bounds();
+        if interval.min()!=lo || interval.max()!=hi {
+            return bounded_error(&bounded_net(a, interval, b)?, b, plane, tol);
+        }
+        if a.degree()!=b.degree() || a.knots()!=b.knots() || a.cpts().len()!=b.cpts().len() {
+            return Err(unknown("full-domain rational basis mismatch"));
+        }
+        let mut error=0.0_f64; let mut uv_hull=[Bound { lo:f64::INFINITY,hi:f64::NEG_INFINITY };2];
+        for (p,q) in a.cpts().iter().zip(b.cpts()) {
+            let w=if p.w==NOW { 1.0 } else { p.w };
+            let qw=if q.w==NOW { 1.0 } else { q.w };
+            if w!=qw || !p.z.is_finite() || p.z==NOZ {
+                return Err(unknown("weights mismatch or non-3D source control"));
+            }
+            let qh=[q.x,q.y,0.0].map(Bound::point);
+            let lifted=plane.lift(qh,w); let ph=[p.x,p.y,p.z].map(Bound::point);
+            let delta: Point=std::array::from_fn(|i| ph[i].sub(lifted[i]).div(Bound::point(w)));
+            let bound=norm(delta);
+            if !bound.is_finite() { return Err(unknown("control-net bound overflow")); }
+            error=error.max(bound);
+            for i in 0..2 {
+                let v=qh[i].div(Bound::point(w));
+                if !v.valid() { return Err(unknown("control hull overflow")); }
+                uv_hull[i].lo=uv_hull[i].lo.min(v.lo); uv_hull[i].hi=uv_hull[i].hi.max(v.hi);
+            }
+        }
+        accept(error,plane.clamp_bound(uv_hull)?,tol)
+    }
+    pub(super) fn check(source: &Curve, interval: &Extent1d, uv: &Curve, surface: &Surface, tol: f64) -> Result<(),String> {
+        if !tol.is_finite() || tol<0.0 || source.dim()!=3 || uv.dim()!=2
+            || !interval.min().is_finite() || !interval.max().is_finite() || interval.min()>=interval.max() {
+            return Err(unknown("invalid dimensions, tolerance or bounded interval"));
+        }
+        let SurfaceKind::Plane(p)=surface.kind() else { return Err(unknown("not an actual plane")); };
+        let plane=Affine::new(p)?;
+        match (source.kind(),uv.kind()) {
+            (CurveKind::Line(a),CurveKind::Line(b))=>lines(a,interval,b,&plane,tol),
+            _=>nets(source,interval,uv,&plane,tol),
+        }
+    }
+}
+
+/// Proves full bounded coverage with analytic lines or a complete shared positive rational basis.
+pub(crate) fn check_planar_uv_projection(
+    _k: &Kernel,
+    source: &solidcore::curve::curve::Curve,
+    interval: &solidcore::geom::extent1d::Extent1d,
+    uv: &solidcore::curve::curve::Curve,
+    surface: &solidcore::surface::surface::Surface,
+    tol: f64,
+) -> Result<(), String> {
+    uv_proof::check(source,interval,uv,surface,tol)
 }
