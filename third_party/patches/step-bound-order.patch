+    pub(super) fn normalize(body: &Body) -> Result<Cow<'_, Body>, String> {
+        let mut result = Cow::Borrowed(body);
+        let used = body.shells.iter().flat_map(|shell| shell.faces.iter().copied()).collect::<std::collections::BTreeSet<_>>();
+        for index in used {
+            let face = body.faces.get(index).ok_or("STEP_BOUND_ORDER: missing shell face")?;
+            let explicit = face.loops.iter().filter(|l| l.outer).count();
+            if explicit > 1 { return Err(error(face, "multiple explicit outer bounds")); }
+            if explicit != 0 || face.loops.len() < 2 || !matches!(face.surface, sm::Surface::Plane { .. }) { continue; }
+            let outer = enclosing_loop(body, face).map_err(|e| error(face, e))?;
+            let target = &mut result.to_mut().faces[index];
+            // 只移动整个环；边顺序、bound.orientation和face.same_sense原样保留。
+            let mut inferred = target.loops.remove(outer);
+            inferred.outer = true;
+            target.loops.insert(0, inferred);
+        }
+        Ok(result)
+    }
