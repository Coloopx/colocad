+    #[derive(Clone, Copy, PartialEq)]
+    struct ProofObject;
+    impl SolutionObject for ProofObject {
+        fn kind(&self) -> ObjectKind { ObjectKind::Curve }
+    }
+
+    fn is_point(s: &Solution<ProofObject>) -> bool {
+        matches!(s.solution_type, SolutionType::SingleValue | SolutionType::PolySingleValue)
+    }
+
+    fn endpoint(curve: &Curve, k: &Kernel, t: f64, tol: f64) -> Result<bool, String> {
+        let ivl = curve.natural_interval();
+        let p = curve.evaluate_point(k, t).map_err(|e| e.to_string())?;
+        for end in [ivl.min(), ivl.max()] {
+            let q = curve.evaluate_point(k, end).map_err(|e| e.to_string())?;
+            if p.distance(q) <= tol { return Ok(true); }
+        }
+        Ok(false)
+    }
+
+    fn simple_curve(k: &Kernel, curve: &Curve, tol: f64) -> Result<(), String> {
+        use solidcore::curve::curve::CurveKind;
+        // 有界直线和不超过一周的解析椭圆不可能自交。
+        if matches!(curve.kind(), CurveKind::Line(_) | CurveKind::Ellipse(_)) { return Ok(()); }
+        let ivl = curve.natural_interval();
+        let solutions = curve.global_curve_self_intersect::<ProofObject>(k, &ivl, tol, None, None).map_err(|e| e.to_string())?;
+        for i in 0..solutions.len() {
+            let s = solutions.get_at(i).map_err(|e| e.to_string())?;
+            let [a, b] = [s.start.parameters[0], s.start.parameters[1]];
+            if !is_point(&s) || !endpoint(curve, k, a, tol)? || !endpoint(curve, k, b, tol)? { return Err("self-intersecting or uncertain curve".into()); }
+            let slack = 64.0 * f64::EPSILON * (1.0 + ivl.min().abs().max(ivl.max().abs()));
+            if !((a - ivl.min()).abs() <= slack && (b - ivl.max()).abs() <= slack || (b - ivl.min()).abs() <= slack && (a - ivl.max()).abs() <= slack) { return Err("ambiguous self contact".into()); }
+        }
+        Ok(())
+    }
+
+    fn boundaries_disjoint(k: &Kernel, body: &Body, curves: &[BoundaryCurve], tol: f64) -> Result<(), String> {
+        let pairs = curves.len().checked_mul(curves.len().saturating_sub(1)).ok_or("boundary pair overflow")? / 2;
+        if pairs > 65_536 { return Err("boundary containment proof budget exceeded".into()); }
+        for (i, a) in curves.iter().enumerate() {
+            for b in curves.iter().skip(i + 1) {
+                let solutions = a.curve.global_curve_intersect::<ProofObject>(k, &a.curve.natural_interval(), &b.curve, &b.curve.natural_interval(), tol, &CurveIntersectOptions::default()).map_err(|e| e.to_string())?;
+                let common = [a.start, a.end].into_iter().filter(|v| a.ring == b.ring && (*v == b.start || *v == b.end)).collect::<Vec<_>>();
+                for j in 0..solutions.len() {
+                    let s = solutions.get_at(j).map_err(|e| e.to_string())?;
+                    if common.is_empty() { return Err("crossing, tangent or coincident boundaries".into()); }
+                    if !is_point(&s) || !endpoint(&a.curve, k, s.start.parameters[0], tol)? || !endpoint(&b.curve, k, s.start.parameters[1], tol)? { return Err("overlap or internal edge contact".into()); }
+                    let q = a.curve.evaluate_point(k, s.start.parameters[0]).map_err(|e| e.to_string())?;
+                    let shared = common.iter().any(|v| body.vertices.get(*v).is_some_and(|v| point(v.point).distance(q) <= tol));
+                    if !shared { return Err("intersection away from shared endpoint".into()); }
+                }
+            }
+        }
+        Ok(())
+    }
