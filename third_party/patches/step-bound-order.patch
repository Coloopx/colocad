+/// True only if a used planar face has no explicit outer and at least two loops.
+fn needs_bound_order(body: &Body) -> Result<bool, String> {
+    let mut needed = false;
+    for shell in &body.shells {
+        for &index in &shell.faces {
+            let face = body.faces.get(index).ok_or("STEP_BOUND_ORDER: missing shell face")?;
+            let explicit = face.loops.iter().filter(|l| l.outer).count();
+            if explicit > 1 {
+                return Err(format!("STEP_BOUND_ORDER face #{}: multiple explicit outer bounds", face.step_id));
+            }
+            needed |= explicit == 0
+                && face.loops.len() >= 2
+                && matches!(face.surface, step_import::model::Surface::Plane { .. });
+        }
+    }
+    Ok(needed)
+}
+
+pub(crate) fn normalize_bound_order(body: &Body) -> Result<std::borrow::Cow<'_, Body>, String> {
+    if !needs_bound_order(body)? {
+        return Ok(std::borrow::Cow::Borrowed(body));
+    }
+    bound_order::normalize(body)
+}
+
+mod bound_order {
+    // [INPUT]: 原始中性Body、原有曲线构造及SolidCore严格几何查询。
+    // [OUTPUT]: 仅重排已证明唯一外环的平面FACE_BOUND集合；歧义返回错误。
+    // [POS]: step-brep构造前置归一；先于拓扑/stitched路径，不修绕向或公差。
+    // [PROTOCOL]: 变更时更新此头部，然后检查 AGENTS.md
+    use std::borrow::Cow;
+    use solidcore::curve::curve::{p8::CurveIntersectOptions, Curve};
+    use solidcore::geom::point_set::PointContainment;
+    use solidcore::geom::solution_array::{ObjectKind, Solution, SolutionObject, SolutionType};
+    use solidcore::query::r#loop::contains_uv_point;
+    use solidcore::surface::surface::p2::SurfaceKind;
+    use step_import::model::{self as sm, Body, Bound, Face};
+    use super::{construct, Kernel, Point3};
+
+    fn error(face: &Face, reason: impl std::fmt::Display) -> String {
+        format!("STEP_BOUND_ORDER face #{}: {reason}", face.step_id)
+    }
+
+    pub(super) fn normalize(body: &Body) -> Result<Cow<'_, Body>, String> {
+        let mut result = Cow::Borrowed(body);
+        let used = body.shells.iter().flat_map(|shell| shell.faces.iter().copied()).collect::<std::collections::BTreeSet<_>>();
+        for index in used {
+            let face = body.faces.get(index).ok_or("STEP_BOUND_ORDER: missing shell face")?;
+            let explicit = face.loops.iter().filter(|l| l.outer).count();
+            if explicit > 1 { return Err(error(face, "multiple explicit outer bounds")); }
+            if explicit != 0 || face.loops.len() < 2 || !matches!(face.surface, sm::Surface::Plane { .. }) { continue; }
+            let outer = enclosing_loop(body, face).map_err(|e| error(face, e))?;
+            let target = &mut result.to_mut().faces[index];
+            // 只移动整个环；边顺序、bound.orientation和face.same_sense原样保留。
+            let mut inferred = target.loops.remove(outer);
+            inferred.outer = true;
+            target.loops.insert(0, inferred);
+        }
+        Ok(result)
+    }
+
+    struct BoundaryCurve {
+        curve: Curve,
+        ring: usize,
+        start: usize,
+        end: usize,
+        bounds: ([f64; 3], [f64; 3]),
+    }
+
+    fn line_bounds(k: &Kernel, curve: &Curve) -> Result<Option<([f64; 3], [f64; 3])>, String> {
+        if !matches!(curve.kind(), solidcore::curve::curve::CurveKind::Line(_)) {
+            return Ok(None);
+        }
+        let interval = curve.natural_interval();
+        let endpoints = [interval.min(), interval.max()].map(|t| {
+            curve.evaluate_point(k, t).map(|p| [p.x, p.y, p.z]).map_err(|e| e.to_string())
+        });
+        let [a, b] = endpoints;
+        let (a, b) = (a?, b?);
+        Ok(Some((
+            std::array::from_fn(|i| a[i].min(b[i])),
+            std::array::from_fn(|i| a[i].max(b[i])),
+        )))
+    }
+
+    fn include_point(lo: &mut [f64; 3], hi: &mut [f64; 3], p: [f64; 3]) {
+        for i in 0..3 {
+            lo[i] = lo[i].min(p[i]);
+            hi[i] = hi[i].max(p[i]);
+        }
+    }
+
+    fn spatial_bounds(
+        k: &Kernel,
+        curve: &Curve,
+        source: &sm::Curve,
+        start: [f64; 3],
+        end: [f64; 3],
+    ) -> Result<([f64; 3], [f64; 3]), String> {
+        let mut lo = std::array::from_fn(|i| start[i].min(end[i]));
+        let mut hi = std::array::from_fn(|i| start[i].max(end[i]));
+        if let Some((llo, lhi)) = line_bounds(k, curve)? {
+            include_point(&mut lo, &mut hi, llo);
+            include_point(&mut lo, &mut hi, lhi);
+        }
+        match source {
+            sm::Curve::Line { .. } => {}
+            sm::Curve::Circle { frame, radius } => {
+                for i in 0..3 {
+                    let extent = radius.abs() * (frame.x[i].abs() + frame.y[i].abs());
+                    lo[i] = lo[i].min(frame.origin[i] - extent);
+                    hi[i] = hi[i].max(frame.origin[i] + extent);
+                }
+            }
+            sm::Curve::Ellipse { frame, semi1, semi2 } => {
+                for i in 0..3 {
+                    let extent = semi1.abs() * frame.x[i].abs() + semi2.abs() * frame.y[i].abs();
+                    lo[i] = lo[i].min(frame.origin[i] - extent);
+                    hi[i] = hi[i].max(frame.origin[i] + extent);
+                }
+            }
+            sm::Curve::BSpline(spline) => {
+                for p in &spline.points {
+                    include_point(&mut lo, &mut hi, *p);
+                }
+            }
+        }
+        Ok((lo, hi))
+    }
+
+    fn adjacent_same_ring(a: &BoundaryCurve, b: &BoundaryCurve) -> bool {
+        a.ring == b.ring && (a.start == b.start || a.start == b.end || a.end == b.start || a.end == b.end)
+    }
+
+    fn separated(a: &BoundaryCurve, b: &BoundaryCurve, tol: f64) -> bool {
+        let ((alo, ahi), (blo, bhi)) = (a.bounds, b.bounds);
+        (0..3).any(|i| {
+            let scale = alo[i].abs().max(ahi[i].abs()).max(blo[i].abs()).max(bhi[i].abs());
+            let padding = tol + 64.0 * f64::EPSILON * (1.0 + scale);
+            blo[i] - ahi[i] > padding || alo[i] - bhi[i] > padding
+        })
+    }
+
+    fn point(p: [f64; 3]) -> Point3 { Point3::new(p[0], p[1], p[2]) }
+
+    fn boundary_curves(k: &Kernel, body: &Body, face: &Face, tol: f64) -> Result<Vec<BoundaryCurve>, String> {
+        let sm::Surface::Plane { frame } = face.surface else { return Err("not planar".into()); };
+        let mut curves = vec![];
+        for (ring, bound) in face.loops.iter().enumerate() {
+            let Bound::Edges(uses) = &bound.bound else { return Err("ambiguous vertex boundary".into()); };
+            if uses.is_empty() { return Err("empty boundary".into()); }
+            let mut ends = vec![];
+            for use_ in uses {
+                let edge = body.edges.get(use_.edge).ok_or("missing edge")?;
+                let (start, end) = if use_.forward { (edge.start, edge.end) } else { (edge.end, edge.start) };
+                let a = body.vertices.get(edge.start).ok_or("missing vertex")?;
+                let b = body.vertices.get(edge.end).ok_or("missing vertex")?;
+                for (s, vertex) in [(0.0, a), (1.0, b)] {
+                    let p = step_import::script::edge_point(edge, s).ok_or("unevaluable edge")?;
+                    if !p.iter().chain(vertex.point.iter()).all(|x| x.is_finite()) || point(p).distance(point(vertex.point)) > tol { return Err("edge endpoint not on source vertex".into()); }
+                }
+                let interval = (edge.t_start.min(edge.t_end), edge.t_start.max(edge.t_end));
+                if !interval.0.is_finite() || !interval.1.is_finite() || interval.0 >= interval.1 { return Err("invalid edge interval".into()); }
+                if matches!(edge.curve, sm::Curve::Circle { .. } | sm::Curve::Ellipse { .. }) && interval.1 - interval.0 > 360.0 + 64.0 * f64::EPSILON * 360.0 { return Err("conic winds more than once".into()); }
+                let curve = crate::make_curve(k, &edge.curve, Some(interval)).map_err(|e| e.to_string())?;
+                if !curve.is_on_plane(k, point(frame.origin), point(frame.z), tol, None).map_err(|e| e.to_string())?.on_plane { return Err("boundary off plane".into()); }
+                simple_curve(k, &curve, tol)?;
+                ends.push((start, end));
+                let start_pt = body.vertices.get(start).ok_or("missing vertex")?.point;
+                let end_pt = body.vertices.get(end).ok_or("missing vertex")?.point;
+                let bounds = spatial_bounds(k, &curve, &edge.curve, start_pt, end_pt)?;
+                curves.push(BoundaryCurve { curve, ring, start, end, bounds });
+            }
+            for i in 0..ends.len() {
+                if ends[i].1 != ends[(i + 1) % ends.len()].0 { return Err("open boundary chain".into()); }
+                if ends.iter().skip(i + 1).any(|other| other.0 == ends[i].0) { return Err("repeated boundary vertex".into()); }
+            }
+        }
+        Ok(curves)
+    }
+
+    #[derive(Clone, Copy, PartialEq)]
+    struct ProofObject;
+    impl SolutionObject for ProofObject {
+        fn kind(&self) -> ObjectKind { ObjectKind::Curve }
+    }
+
+    fn is_point(s: &Solution<ProofObject>) -> bool {
+        matches!(s.solution_type, SolutionType::SingleValue | SolutionType::PolySingleValue)
+    }
+
+    fn endpoint(curve: &Curve, k: &Kernel, t: f64, tol: f64) -> Result<bool, String> {
+        let ivl = curve.natural_interval();
+        let p = curve.evaluate_point(k, t).map_err(|e| e.to_string())?;
+        for end in [ivl.min(), ivl.max()] {
+            let q = curve.evaluate_point(k, end).map_err(|e| e.to_string())?;
+            if p.distance(q) <= tol { return Ok(true); }
+        }
+        Ok(false)
+    }
+
+    fn simple_curve(k: &Kernel, curve: &Curve, tol: f64) -> Result<(), String> {
+        use solidcore::curve::curve::CurveKind;
+        // 有界直线和不超过一周的解析椭圆不可能自交。
+        if matches!(curve.kind(), CurveKind::Line(_) | CurveKind::Ellipse(_)) { return Ok(()); }
+        let ivl = curve.natural_interval();
+        let solutions = curve.global_curve_self_intersect::<ProofObject>(k, &ivl, tol, None, None).map_err(|e| e.to_string())?;
+        for i in 0..solutions.len() {
+            let s = solutions.get_at(i).map_err(|e| e.to_string())?;
+            let [a, b] = [s.start.parameters[0], s.start.parameters[1]];
+            if !is_point(&s) || !endpoint(curve, k, a, tol)? || !endpoint(curve, k, b, tol)? { return Err("self-intersecting or uncertain curve".into()); }
+            let slack = 64.0 * f64::EPSILON * (1.0 + ivl.min().abs().max(ivl.max().abs()));
+            if !((a - ivl.min()).abs() <= slack && (b - ivl.max()).abs() <= slack || (b - ivl.min()).abs() <= slack && (a - ivl.max()).abs() <= slack) { return Err("ambiguous self contact".into()); }
+        }
+        Ok(())
+    }
+
+    #[inline(never)]
+    fn boundaries_disjoint(k: &Kernel, body: &Body, curves: &[BoundaryCurve], tol: f64) -> Result<(), String> {
+        let mut candidates = 0;
+        for (i, a) in curves.iter().enumerate() {
+            for b in curves.iter().skip(i + 1) {
+                if adjacent_same_ring(a, b) { continue; }
+                if separated(a, b, tol) { continue; }
+                candidates += 1;
+                if candidates > 65_536 { return Err("boundary containment proof budget exceeded".into()); }
+                let solutions = a.curve.global_curve_intersect::<ProofObject>(k, &a.curve.natural_interval(), &b.curve, &b.curve.natural_interval(), tol, &CurveIntersectOptions::default()).map_err(|e| e.to_string())?;
+                let common = [a.start, a.end].into_iter().filter(|v| a.ring == b.ring && (*v == b.start || *v == b.end)).collect::<Vec<_>>();
+                for j in 0..solutions.len() {
+                    let s = solutions.get_at(j).map_err(|e| e.to_string())?;
+                    if common.is_empty() { return Err("crossing, tangent or coincident boundaries".into()); }
+                    if !is_point(&s) || !endpoint(&a.curve, k, s.start.parameters[0], tol)? || !endpoint(&b.curve, k, s.start.parameters[1], tol)? { return Err("overlap or internal edge contact".into()); }
+                    let q = a.curve.evaluate_point(k, s.start.parameters[0]).map_err(|e| e.to_string())?;
+                    let shared = common.iter().any(|v| body.vertices.get(*v).is_some_and(|v| point(v.point).distance(q) <= tol));
+                    if !shared { return Err("intersection away from shared endpoint".into()); }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn trial_body(body: &Body, face: &Face) -> Result<Body, String> {
+        let mut edges = Vec::new();
+        let mut vertices = Vec::new();
+        let mut edge_of = vec![None; body.edges.len()];
+        let mut vertex_of = vec![None; body.vertices.len()];
+        let map_vertex = |index: usize, vertices: &mut Vec<sm::Vertex>, vertex_of: &mut [Option<usize>]| -> Result<usize, String> {
+            if let Some(mapped) = vertex_of.get(index).copied().flatten() {
+                return Ok(mapped);
+            }
+            let vertex = body.vertices.get(index).ok_or("missing vertex")?;
+            let mapped = vertices.len();
+            *vertex_of.get_mut(index).ok_or("missing vertex")? = Some(mapped);
+            vertices.push(vertex.clone());
+            Ok(mapped)
+        };
+        let mut loops = Vec::with_capacity(face.loops.len());
+        for bound in &face.loops {
+            loops.push(sm::Loop {
+                outer: bound.outer,
+                orientation: bound.orientation,
+                bound: match &bound.bound {
+                    Bound::Vertex(index) => Bound::Vertex(map_vertex(*index, &mut vertices, &mut vertex_of)?),
+                    Bound::Edges(uses) => {
+                        let mut mapped = Vec::with_capacity(uses.len());
+                        for use_ in uses {
+                            let slot = edge_of.get_mut(use_.edge).ok_or("missing edge")?;
+                            if slot.is_none() {
+                                let edge = body.edges.get(use_.edge).ok_or("missing edge")?;
+                                let mut copied = edge.clone();
+                                copied.start = map_vertex(edge.start, &mut vertices, &mut vertex_of)?;
+                                copied.end = map_vertex(edge.end, &mut vertices, &mut vertex_of)?;
+                                *slot = Some(edges.len());
+                                edges.push(copied);
+                            }
+                            mapped.push(sm::OrientedEdge { edge: (*slot).ok_or("missing edge")?, forward: use_.forward });
+                        }
+                        Bound::Edges(mapped)
+                    }
+                },
+            });
+        }
+        Ok(Body {
+            step_id: body.step_id,
+            name: None,
+            kind: sm::BodyKind::ShellModel,
+            unit_mm: body.unit_mm,
+            uncertainty_mm: body.uncertainty_mm,
+            shells: vec![sm::Shell { step_id: 0, closed: false, orientation: true, faces: vec![0] }],
+            faces: vec![Face {
+                step_id: face.step_id,
+                surface: face.surface.clone(),
+                same_sense: face.same_sense,
+                loops,
+            }],
+            edges,
+            vertices,
+        })
+    }
+
+    #[inline(never)]
+    fn enclosing_loop(body: &Body, face: &Face) -> Result<usize, String> {
+        let count = face.loops.iter().try_fold(0usize, |n, l| match &l.bound {
+            Bound::Edges(edges) => n.checked_add(edges.len()).ok_or("boundary count overflow"),
+            Bound::Vertex(_) => Err("ambiguous vertex boundary"),
+        })?;
+        if count > 4096 { return Err("boundary containment proof edge budget exceeded".into()); }
+        let trial = trial_body(body, face)?;
+        let mut made = construct(&trial)?;
+        if !made.failures.is_empty() || made.faces.len() != 1 { return Err("incomplete containment probe".into()); }
+        made.kernel.fixes.query_statuses_pass_on = true;
+        let tol = made.brep.tolerance();
+        let curves = boundary_curves(&made.kernel, body, face, tol)?;
+        boundaries_disjoint(&made.kernel, body, &curves, tol)?;
+        let f = made.faces[0].0;
+        {
+            let face = made.brep.face_mut(f).map_err(|e| e.to_string())?;
+            let surface = face.surface.as_mut().ok_or("missing plane")?;
+            let SurfaceKind::Plane(plane) = surface.kind_mut() else { return Err("containment surface changed".into()); };
+            // The temporary plane must include the projected control hull. A
+            // tight face domain can clip a pole even when the entire edge lies
+            // inside it, forcing the drop to approximate an exact planar curve.
+            let domain = super::uv_proof::control_hull_domain(plane, face.uv_domain, curves.iter().map(|c| &c.curve))?;
+            plane.adjust_step_uv_domain(&domain).map_err(|e| e.to_string())?;
+            face.uv_domain = domain;
+        }
+        let loops = solidcore::topology::face::p2::loops(&made.brep, f, false, None).map_err(|e| e.to_string())?;
+        if loops.len() != face.loops.len() { return Err("boundary count changed".into()); }
+        // 包含查询只消费经原3D曲线复核的派生UV；投影失真不能决定环序。
+        solidcore::topology::face::p3::create_uv_trim_curves(&made.kernel, &mut made.brep, f, false, None).map_err(|e| e.to_string())?;
+        let fu = made.brep.face(f).map_err(|e| e.to_string())?.faceuse.ok_or("missing faceuse")?;
+        for eu in solidcore::topology::edgeuse::p1::faceuse_edgeuses(&made.brep, fu, false, None).map_err(|e| e.to_string())? {
+            let trim = solidcore::topology::edgeuse::p1::uv_trim_curve(&made.brep, eu).map_err(|e| e.to_string())?.0.ok_or("missing UV proof")?;
+            let edge_id = made.brep.edgeuse(eu).map_err(|e| e.to_string())?.edge.ok_or("missing proof edge")?;
+            let edge = made.brep.edge(edge_id).map_err(|e| e.to_string())?;
+            let original = edge.curve.as_ref().ok_or("missing proof curve")?;
+            let surface = made.brep.face(f).map_err(|e| e.to_string())?.surface.as_ref().ok_or("missing plane")?;
+            super::check_planar_uv_projection(&made.kernel, original, &edge.interval, trim, surface, tol)?;
+        }
+        let mut uv = vec![];
+        {
+            let surface = made.brep.face(f).map_err(|e| e.to_string())?.surface.as_ref().ok_or("missing plane")?;
+            let SurfaceKind::Plane(plane) = surface.kind() else { return Err("containment surface changed".into()); };
+            for bound in &face.loops {
+                let Bound::Edges(uses) = &bound.bound else { return Err("vertex boundary".into()); };
+                let edge = body.edges.get(uses[0].edge).ok_or("missing sample edge")?;
+                let sample = step_import::script::edge_point(edge, 0.5).ok_or("unevaluable boundary sample")?;
+                uv.push(plane.project_point_to_uv_domain(point(sample)));
+            }
+        }
+        let mut parents = vec![vec![]; loops.len()];
+        let mut orientations = vec![];
+        for (i, &l) in loops.iter().enumerate() {
+            let orient = solidcore::topology::face::p3::compute_loop_orientation(&made.kernel, &mut made.brep, f, l, None, false).map_err(|e| e.to_string())?;
+            if orient == solidcore::nurbs::b_spline_surface_n_lib::p2::OrientType::Unknown { return Err("degenerate or uncertain loop".into()); }
+            orientations.push(orient);
+            for (j, sample) in uv.iter().enumerate() {
+                if i == j { continue; }
+                match contains_uv_point(&made.kernel, &mut made.brep, l, None, *sample, tol).map_err(|e| e.to_string())?.containment {
+                    PointContainment::Inside => parents[j].push(i),
+                    PointContainment::Outside => (),
+                    _ => return Err("boundary contact or unknown containment".into()),
+                }
+            }
+        }
+        let roots = parents.iter().enumerate().filter_map(|(i, p)| p.is_empty().then_some(i)).collect::<Vec<_>>();
+        if roots.len() != 1 { return Err("multiple or missing enclosing boundaries".into()); }
+        let outer = roots[0];
+        if parents.iter().enumerate().any(|(i, p)| i != outer && p.as_slice() != [outer]) { return Err("nested holes or ambiguous enclosure".into()); }
+        // constructor已消费face sense建立loop-use方向；这里不能再次套source绝对符号。
+        // 只证明孔环与外环相反；不翻转任何环，绝对绕向仍交原kernel Test3检查。
+        let outer_orientation = orientations[outer];
+        if orientations.iter().enumerate().any(|(i, actual)| i != outer && *actual == outer_orientation) {
+            return Err("hole boundary winding matches enclosing boundary".into());
+        }
+        Ok(outer)
+    }
+
+}
