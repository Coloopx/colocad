+    fn boundary_curves(k: &Kernel, body: &Body, face: &Face, tol: f64) -> Result<Vec<BoundaryCurve>, String> {
+        let sm::Surface::Plane { frame } = face.surface else { return Err("not planar".into()); };
+        let mut curves = vec![];
+        for (ring, bound) in face.loops.iter().enumerate() {
+            let Bound::Edges(uses) = &bound.bound else { return Err("ambiguous vertex boundary".into()); };
+            if uses.is_empty() { return Err("empty boundary".into()); }
+            let mut ends = vec![];
+            for use_ in uses {
+                let edge = body.edges.get(use_.edge).ok_or("missing edge")?;
+                let (start, end) = if use_.forward { (edge.start, edge.end) } else { (edge.end, edge.start) };
+                let a = body.vertices.get(edge.start).ok_or("missing vertex")?;
+                let b = body.vertices.get(edge.end).ok_or("missing vertex")?;
+                for (s, vertex) in [(0.0, a), (1.0, b)] {
+                    let p = step_import::script::edge_point(edge, s).ok_or("unevaluable edge")?;
+                    if !p.iter().chain(vertex.point.iter()).all(|x| x.is_finite()) || point(p).distance(point(vertex.point)) > tol { return Err("edge endpoint not on source vertex".into()); }
+                }
+                let interval = (edge.t_start.min(edge.t_end), edge.t_start.max(edge.t_end));
+                if !interval.0.is_finite() || !interval.1.is_finite() || interval.0 >= interval.1 { return Err("invalid edge interval".into()); }
+                if matches!(edge.curve, sm::Curve::Circle { .. } | sm::Curve::Ellipse { .. }) && interval.1 - interval.0 > 360.0 + 64.0 * f64::EPSILON * 360.0 { return Err("conic winds more than once".into()); }
+                let curve = crate::make_curve(k, &edge.curve, Some(interval)).map_err(|e| e.to_string())?;
+                if !curve.is_on_plane(k, point(frame.origin), point(frame.z), tol, None).map_err(|e| e.to_string())?.on_plane { return Err("boundary off plane".into()); }
+                simple_curve(k, &curve, tol)?;
+                ends.push((start, end));
+                curves.push(BoundaryCurve { curve, ring, start, end });
+            }
+            for i in 0..ends.len() {
+                if ends[i].1 != ends[(i + 1) % ends.len()].0 { return Err("open boundary chain".into()); }
+                if ends.iter().skip(i + 1).any(|other| other.0 == ends[i].0) { return Err("repeated boundary vertex".into()); }
+            }
+        }
+        Ok(curves)
+    }
