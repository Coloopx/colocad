+/// Map a UV trim by its surface metric and recertify mapped curvature.
+/// Kept out of `assert_valid_with` so identity/analytic checks do not retain
+/// mapped-curve TEXT in the main validation CGU.
+#[inline(never)]
+fn uv_trim_mapped_radius(
+    k: &Kernel,
+    trim: &BSplineCurve,
+    bounded: bool,
+    surface: Option<&Surface>,
+    domain: &Extent1d,
+    size_t: f64,
+    bbox: Option<Extent3d>,
+    regularity_allowed: bool,
+    regularity: Option<(f64, f64)>,
+    sized: bool,
+    tol: f64,
+    min_sep: f64,
+) -> Result<UvMappedRadius> {
+    let mut mapped = None;
+    let (mut radius_sized, mut radius_tol, mut radius_sep) = (sized, tol, min_sep);
+    let mut radius_regularity = regularity;
+    let Some(l) = trim_metric(k, trim, bounded, surface, domain)? else {
+        return Ok(UvMappedRadius {
+            mapped,
+            metric: false,
+            radius_sized,
+            radius_tol,
+            radius_sep,
+            radius_regularity,
+        });
+    };
+    // Exact identity uses the same curve and bounding-box request as the speed check.
+    let mapped_box = if l == [1.0, 0.0, 1.0] {
+        bbox.filter(|_| trim.nurb.is_some())
+    } else {
+        mapped = mapped_trim(trim, l);
+        match mapped.as_ref() {
+            Some(m) => ignored(m.calculate_bounding_box(
+                domain,
+                BoundingBoxRequest {
+                    normal: true,
+                    pseudo: false,
+                    polar: false,
+                },
+            ))?
+            .and_then(|b| b.normal),
+            None => None,
+        }
+    };
+    radius_sized = mapped_box.is_some();
+    if let Some(mapped_box) = mapped_box {
+        let mapped_size = mapped_box.size().length();
+        radius_tol = (mapped_size / size_t) / 10000.0;
+        radius_sep = mapped_size / max2(20., size_t);
+    }
+    // Curvature proof uses millimetre-mapped poles; the UV certificate is not reused.
+    radius_regularity = match mapped.as_ref() {
+        Some(curve) if regularity_allowed && radius_sized => quadratic_regularity(curve, domain),
+        Some(_) => None,
+        None => regularity,
+    };
+    Ok(UvMappedRadius {
+        mapped,
+        metric: true,
+        radius_sized,
+        radius_tol,
+        radius_sep,
+        radius_regularity,
+    })
+}
+
+/// Non-identity metrics only; identity coincident-pole checks keep the source trim.
+#[inline(never)]
+fn uv_mapped_pole(
+    k: &Kernel,
+    trim: &BSplineCurve,
+    bounded: bool,
+    surface: Option<&Surface>,
+) -> Result<Option<BSplineCurve>> {
+    let interval = trim.natural_interval();
+    Ok(match trim_metric(k, trim, bounded, surface, &interval)? {
+        Some(l) if l != [1.0, 0.0, 1.0] => mapped_trim(trim, l),
+        _ => None,
+    })
+}
