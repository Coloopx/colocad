+/// Keep cone/sphere sense flags out of the face loop so the extra match is not
+/// inlined into that body. Both `swap_uv` and `inside_out` are const surface flags.
+#[inline(never)]
+fn xor_analytic_same_sense(same_sense: bool, surf: &solidcore::surface::surface::Surface) -> bool {
+    use solidcore::surface::surface::SurfaceKind;
+    match surf.kind() {
+        SurfaceKind::Cone(cone) => {
+            let canonical = cone.canonical();
+            same_sense ^ canonical.swap_uv ^ canonical.inside_out
+        }
+        SurfaceKind::Sphere(sphere) => same_sense ^ sphere.base().swap_uv() ^ sphere.inside_out(),
+        _ => same_sense,
+    }
+}
+
+fn export_body(
+    step_id: u64,
+    sheet: bool,
+    voids: bool,
+    shells: Vec<Shell>,
+    faces: Vec<Face>,
+    edges: Vec<Edge>,
+    vertices: Vec<Vertex>,
+) -> Body {
+    Body {
+        step_id,
+        name: None,
+        kind: if sheet {
+            BodyKind::ShellModel
+        } else if voids {
+            BodyKind::SolidWithVoids
+        } else {
+            BodyKind::ManifoldSolid
+        },
+        unit_mm: 1.0,
+        uncertainty_mm: None,
+        shells,
+        faces,
+        edges,
+        vertices,
     }
+}
+
+/// One shell, or one solid's outer+void shells, can own the geometry tables.
+/// A compound keeps a body per shell so product assemblies stay separate solids.
+#[inline(never)]
+fn export_shell_bodies(
+    sheet: bool,
+    material_solids: usize,
+    shells: Vec<Shell>,
+    faces: Vec<Face>,
+    edges: Vec<Edge>,
+    vertices: Vec<Vertex>,
+) -> Vec<Body> {
+    let share = shells.len() == 1 || (!sheet && material_solids == 1);
+    if share {
+        return vec![export_body(
+            1,
+            sheet,
+            !sheet && shells.len() > 1,
+            shells,
+            faces,
+            edges,
+            vertices,
+        )];
+    }
+    shells
+        .into_iter()
+        .enumerate()
+        .map(|(index, shell)| {
+            export_body(
+                index as u64 + 1,
+                sheet,
+                false,
+                vec![shell],
+                faces.clone(),
+                edges.clone(),
+                vertices.clone(),
+            )
+        })
+        .collect()
 }
 
