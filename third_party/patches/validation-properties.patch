+/// Only successful output of a pure, unowned BSpline property solver is shared.
+/// The entire key is compared after hashing. Bound input and output sizes as well
+/// as entry count, independently of how many definitions the assembly contains.
+#[derive(Debug, Default)]
+pub(crate) struct ValidationPropertyMemo {
+    pub(crate) enabled: bool,
+    pub(crate) hits: usize,
+    pub(crate) misses: usize,
+    pub(crate) certified: usize,
+    bytes: usize,
+    policy: Option<crate::curve::curve::p5::CurveMemoKey>,
+    values: std::collections::HashMap<Vec<u64>, Vec<SolutionEnd>>,
+}
+
+fn property_key(
+    k: &Kernel,
+    curve: &BSplineCurve,
+    domain: &Extent1d,
+    property: CurveProperty,
+    sep: f64,
+) -> Option<Vec<u64>> {
+    if !k.caches.validation_properties.borrow().enabled || k.cancel.is_some() {
+        return None;
+    }
+    let policy = crate::curve::curve::p5::CurveMemoKey::of_kernel(k)?;
+    let n = curve.nurb.as_ref()?;
+    let pts = n.cpts();
+    let knots = n.knots();
+    if pts.len() > 256 || knots.len() > 512 || pts.len() != n.n() + 1 || knots.len() != n.m() + 1 {
+        return None;
+    }
+    let mut key = Vec::with_capacity(12 + pts.len() * 4 + knots.len());
+    key.extend([
+        property as u64,
+        domain.min().to_bits(),
+        domain.max().to_bits(),
+        sep.to_bits(),
+        curve.dim,
+        curve.knot_type as u64,
+        curve.form as u64,
+        curve.out_of_bounds_enabled as u64,
+        curve.nurb_is_borrowed as u64,
+        n.degree() as u64,
+        pts.len() as u64,
+        knots.len() as u64,
+    ]);
+    key.extend(knots.iter().map(|v| v.to_bits()));
+    for p in pts {
+        key.extend([p.x.to_bits(), p.y.to_bits(), p.z.to_bits(), p.w.to_bits()]);
+    }
+    let mut memo = k.caches.validation_properties.borrow_mut();
+    if memo.policy != Some(policy) {
+        memo.values.clear();
+        memo.bytes = 0;
+        memo.policy = Some(policy);
+    }
+    Some(key)
+}
