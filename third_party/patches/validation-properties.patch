+// Bounds for a clamped chain of well-conditioned rational quadratic Bézier spans.
+// C'(u)=D(u)/W(u)^2 on the unit span. D is quadratic with the three poles below.
+// A projection bounded away from zero bounds speed from below. Since
+// C''=D'/W²-2DW'/W³, an upper bound for acceleration gives R >= |C'|²/|C''|.
+// At knots these are one-sided bounds. Knot continuity and kink checks still run.
+fn quadratic_regularity(curve: &BSplineCurve, domain: &Extent1d) -> Option<(f64, f64)> {
+    let n = curve.nurb.as_ref()?;
+    let pts = n.cpts();
+    let knots = n.knots();
+    if n.degree() != 2
+        || !matches!(curve.dim, 2 | 3)
+        || !n.is_rational()
+        || pts.len() < 3
+        || pts.len() > 129
+        || pts.len() % 2 != 1
+        || knots.len() != pts.len() + 3
+        || !knots.iter().all(|x| x.is_finite())
+        || knots[..3] != [domain.min(); 3]
+        || knots[pts.len()..] != [domain.max(); 3]
+    {
+        return None;
+    }
+    let mut speed = f64::INFINITY;
+    let mut radius = f64::INFINITY;
+    for i in (0..pts.len() - 2).step_by(2) {
+        let dt = knots[i + 3] - knots[i + 2];
+        if knots[i + 3] != knots[i + 4]
+            || !(dt > 1e-9 * (1. + domain.min().abs().max(domain.max().abs())) && dt < 1e8)
+        {
+            return None;
+        }
+        let a = pts[i];
+        let b = pts[i + 1];
+        let c = pts[i + 2];
+        let weights = [a.w, b.w, c.w];
+        if !weights.iter().all(|w| (0.25..=4.).contains(w)) {
+            return None;
+        }
+        let wmin = a.w.min(b.w).min(c.w);
+        let wmax = a.w.max(b.w).max(c.w);
+        let (pa, pb, pc) = (a.to_euclid(), b.to_euclid(), c.to_euclid());
+        let mut scale = 1.0_f64;
+        for p in [pa, pb, pc] {
+            for x in [p.x, p.y, p.z] {
+                if !x.is_finite() || x.abs() > 1e7 {
+                    return None;
+                }
+                scale = scale.max(x.abs());
+            }
+        }
+        let chord = pc - pa;
+        let sign = |x: f64| {
+            if x > 0. {
+                1.
+            } else if x < 0. {
+                -1.
+            } else {
+                0.
+            }
+        };
+        let direction = Vec3::new(sign(chord.x), sign(chord.y), sign(chord.z));
+        let d = [
+            (pb - pa) * (2. * a.w * b.w),
+            chord * (a.w * c.w),
+            (pc - pb) * (2. * b.w * c.w),
+        ];
+        let guard = 4096. * f64::EPSILON * scale * wmax.max(1.).powi(2);
+        let projected = d
+            .iter()
+            .map(|p| p.dot(direction))
+            .fold(f64::INFINITY, f64::min)
+            - guard;
+        if !(projected.is_finite() && projected > 0.) {
+            return None;
+        }
+        // |direction| <= sqrt(3). Extra factors make the inequalities conservative.
+        let velocity = projected / (2. * wmax * wmax);
+        let magnitude = d
+            .iter()
+            .map(|v| v.x.abs() + v.y.abs() + v.z.abs())
+            .fold(0., f64::max)
+            + guard;
+        // Derivatives of the two quadratic Bernstein polynomials are linear.
+        // Bound them by their actual derivative poles, including roundoff.
+        let l1 = |v: Vec3| v.x.abs() + v.y.abs() + v.z.abs();
+        let dprime = 2. * l1(d[1] - d[0]).max(l1(d[2] - d[1])) + 4. * guard;
+        let wprime = 2. * (b.w - a.w).abs().max((c.w - b.w).abs()) + 64. * f64::EPSILON * wmax;
+        let acceleration =
+            1.5 * (dprime / (wmin * wmin) + 2. * magnitude * wprime / (wmin * wmin * wmin));
+        speed = speed.min(velocity / dt);
+        radius = radius.min(velocity * velocity / acceleration);
+    }
+    (speed.is_finite() && radius.is_finite()).then_some((speed, radius))
+}
