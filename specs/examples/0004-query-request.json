{
  "schema": "colocad.query/1",
  "query_revision_id": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
  "target": {"instance_path": ["drive", "motor"]},
  "space": "assembly",
  "tolerance": {"linear_mm": 0.0001, "angular_rad": 0.000001},
  "queries": [
    {"id": "mounting_planes", "op": "faces", "where": {"surface_type": "plane", "area_mm2": {"min": 400, "max": 10000}}, "limit": 64},
    {"id": "mounting_bores", "op": "holes", "where": {"diameter_mm": {"min": 6.5, "max": 6.7}, "termination": "through"}, "limit": 64}
  ]
}
