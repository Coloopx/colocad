# Optional public equivalent of the development image used in the recorded run.
FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglu1-mesa libxrender1 libxext6 libsm6 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir 'build123d==0.11.1' 'cadquery-ocp-novtk==7.9.3.1.1' 'numpy==2.5.4' && python3 -c 'import build123d'
