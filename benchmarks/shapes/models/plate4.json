{
  "version": 1,
  "units": "mm",
  "parameters": {
    "width": 80,
    "length": 50,
    "thickness": 6,
    "hole_radius": 3,
    "holes_x": 2
  },
  "features": [
    {
      "op": "box",
      "id": "blank",
      "origin": [
        0,
        0,
        0
      ],
      "size": [
        {
          "param": "width"
        },
        {
          "param": "length"
        },
        {
          "param": "thickness"
        }
      ]
    },
    {
      "op": "hole_grid",
      "id": "mounting_holes",
      "input": "blank",
      "origin": [
        15,
        15,
        -1
      ],
      "radius": {
        "param": "hole_radius"
      },
      "depth": {
        "op": "add",
        "a": {
          "param": "thickness"
        },
        "b": 2
      },
      "count": [
        {
          "param": "holes_x"
        },
        2
      ],
      "spacing": [
        50,
        20
      ]
    }
  ],
  "output": "mounting_holes"
}
